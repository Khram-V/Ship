  <CompilerOptions>
    <Version Value="11"/>
    <PathDelim Value="\"/>
    <Target>
      <Filename Value="..\FreeShip"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="Units;Forms;$(ProjOutDir)"/>
      <OtherUnitFiles Value="Units;Forms"/>
      <UnitOutputDirectory Value="..\Work\Obj\$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Parsing>
